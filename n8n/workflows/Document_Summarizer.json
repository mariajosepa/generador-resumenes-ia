    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Leer el HTML desde el binario descargado\nconst html = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n\n// 2. Limpiar HTML complejo: scripts, estilos, JSON-LD, comentarios\nlet text = html\n  .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, \" \")\n  .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, \" \")\n  .replace(/<noscript[^>]*>[\\s\\S]*?<\\/noscript>/gi, \" \")\n  .replace(/<!--[\\s\\S]*?-->/g, \" \")\n  .replace(/<[^>]+>/g, \" \")        // eliminar etiquetas HTML\n  .replace(/\\s+/g, \" \")            // espacios múltiples\n  .trim();\n\n// 3. Devolver el texto limpio para el nodo de resumen\nreturn {\n  json: {\n    data: text\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
